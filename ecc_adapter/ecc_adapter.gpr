with "config/ecc_adapter_config.gpr";
project Ecc_Adapter is

   for Library_Name use "Ecc_Adapter";
   for Library_Version use Project'Library_Name & ".so." & Ecc_Adapter_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Ecc_Adapter_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
      external ("ECC_ADAPTER_LIBRARY_TYPE", external ("LIBRARY_TYPE", "relocatable"));
   for Library_Kind use Library_Type;

   --  Force Ada runtime initialization at library load time.
   --  Without this, the linker strips adainit and ctypes calls segfault.
   for Library_Auto_Init use "True";

   package Compiler is
      for Default_Switches ("Ada") use Ecc_Adapter_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   for Library_Options use
     ("-L/opt/homebrew/opt/python@3.15/Frameworks/Python.framework/Versions/3.15/lib",
      "-lpython3.15",
      "-framework", "CoreFoundation");

end Ecc_Adapter;
